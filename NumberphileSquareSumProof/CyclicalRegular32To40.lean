theorem cyclical_regular_number_of_ge_32_le_40 :
∀ n : ℕ, n ≥ 32 → n ≤ 40 → CyclicalRegularNumber n := by
  intro n hn hle
  have hwitness : ∀ i : Fin 9,
      (cyclical_regular_32_to_40_list[i.val]).Perm (List.range' 1 (i.val + 32)) ∧
      CyclicalRegularList (cyclical_regular_32_to_40_list[i.val]) := by decide
  have hi : n - 32 < 9 := by omega
  have hperm := (hwitness ⟨n - 32, hi⟩).1
  have hcyc  := (hwitness ⟨n - 32, hi⟩).2
  simp only [Nat.sub_add_cancel hn] at hperm
  exact ⟨_, hperm, hcyc⟩
